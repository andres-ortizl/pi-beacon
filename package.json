{
  "name": "pi-beacon",
  "version": "1.1.0",
  "description": "Live Pi session and subagent observability for Linux desktops",
  "type": "module",
  "scripts": {
    "format": "biome check --write . && prettier --write \"site/**/*.html\" \"*.yaml\" \".github/**/*.yml\"",
    "format:check": "biome check . && prettier --check \"site/**/*.html\" \"*.yaml\" \".github/**/*.yml\"",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "observability",
    "quickshell",
    "waybar"
  ],
  "author": "Andres Ortiz",
  "license": "MIT",
  "homepage": "https://andres-ortizl.github.io/pi-beacon/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andres-ortizl/pi-beacon.git"
  },
  "bugs": {
    "url": "https://github.com/andres-ortizl/pi-beacon/issues"
  },
  "files": [
    "extension/index.ts",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extension/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/andres-ortizl/pi-beacon/main/docs/images/pi-beacon-dashboard.png"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@types/node": "^26.4.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
