{
  "$defs": {
    "ContextStats": {
      "properties": {
        "contextWindow": {
          "title": "Contextwindow",
          "type": "integer"
        },
        "percent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Percent"
        },
        "tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens"
        }
      },
      "required": [
        "contextWindow"
      ],
      "title": "ContextStats",
      "type": "object"
    },
    "SessionState": {
      "enum": [
        "open",
        "idle",
        "running",
        "waiting"
      ],
      "title": "SessionState",
      "type": "string"
    },
    "UsageStats": {
      "properties": {
        "cacheRead": {
          "default": 0,
          "title": "Cacheread",
          "type": "integer"
        },
        "cacheWrite": {
          "default": 0,
          "title": "Cachewrite",
          "type": "integer"
        },
        "cost": {
          "default": 0,
          "title": "Cost",
          "type": "number"
        },
        "input": {
          "default": 0,
          "title": "Input",
          "type": "integer"
        },
        "output": {
          "default": 0,
          "title": "Output",
          "type": "integer"
        },
        "subagentCost": {
          "default": 0,
          "title": "Subagentcost",
          "type": "number"
        },
        "totalTokens": {
          "default": 0,
          "title": "Totaltokens",
          "type": "integer"
        }
      },
      "title": "UsageStats",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "context": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContextStats"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cwd": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cwd"
    },
    "detail": {
      "default": "",
      "title": "Detail",
      "type": "string"
    },
    "displayName": {
      "default": "",
      "title": "Displayname",
      "type": "string"
    },
    "elapsed": {
      "default": "",
      "title": "Elapsed",
      "type": "string"
    },
    "kind": {
      "default": "session",
      "title": "Kind",
      "type": "string"
    },
    "lastMessageAt": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lastmessageat"
    },
    "model": {
      "default": "",
      "title": "Model",
      "type": "string"
    },
    "parentPid": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parentpid"
    },
    "pid": {
      "title": "Pid",
      "type": "integer"
    },
    "project": {
      "title": "Project",
      "type": "string"
    },
    "prompt": {
      "default": "",
      "title": "Prompt",
      "type": "string"
    },
    "sessionFile": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sessionfile"
    },
    "sessionId": {
      "title": "Sessionid",
      "type": "string"
    },
    "sessionName": {
      "default": "",
      "title": "Sessionname",
      "type": "string"
    },
    "startedAt": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Startedat"
    },
    "state": {
      "$ref": "#/$defs/SessionState",
      "default": "open"
    },
    "thinking": {
      "default": "",
      "title": "Thinking",
      "type": "string"
    },
    "titleSource": {
      "default": "project",
      "title": "Titlesource",
      "type": "string"
    },
    "updatedAt": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updatedat"
    },
    "usage": {
      "$ref": "#/$defs/UsageStats"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "pid",
    "sessionId",
    "project"
  ],
  "title": "LiveSession",
  "type": "object"
}
